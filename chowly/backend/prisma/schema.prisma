// Chowly data model
// Implements the ER model from "CHOWLY ENTITY RELATIONSHIP MODEL" (Chiedozie Maduabuchi),
// with three changes made during the build — each one explained in the project README
// under "Changes from the original model":
//
// 1. No Login/Auth table. The brief says "logins are not required, a simple switch is
//    enough", so a Customer row is created just by typing a name — no password/account.
// 2. Visit gained a `tableNumber` field. The original model didn't need one because it
//    wasn't tracking where in the restaurant an order came from — but a walk-in, no-login
//    flow needs to know which physical table placed the order.
// 3. Order.status is a proper enum (was a free-text VARCHAR) so the API and UI can rely on
//    a fixed set of states: PENDING, PREPARING, SERVED, DELAYED.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PREPARING
  SERVED
  DELAYED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Restaurant {
  id            Int         @id @default(autoincrement())
  name          String
  address       String
  phoneNumber   String
  email         String
  openingHours  String
  menuItems     MenuItem[]
  waiters       Waiter[]
  chefs         Chef[]
  bartenders    Bartender[]
  visits        Visit[]
  createdAt     DateTime    @default(now())
}

model Customer {
  id             Int        @id @default(autoincrement())
  fullName       String
  phoneNumber    String?
  dateRegistered DateTime   @default(now())
  visits         Visit[]
  payments       Payment[]
  feedbacks      Feedback[]
}

model Visit {
  id            Int        @id @default(autoincrement())
  customer      Customer   @relation(fields: [customerId], references: [id])
  customerId    Int
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  Int
  tableNumber   Int
  checkInTime   DateTime   @default(now())
  checkOutTime  DateTime?
  orders        Order[]
}

model MenuCategory {
  id           Int        @id @default(autoincrement())
  categoryName String
  menuItems    MenuItem[]
}

model MenuItem {
  id                     Int          @id @default(autoincrement())
  restaurant             Restaurant   @relation(fields: [restaurantId], references: [id])
  restaurantId           Int
  category               MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId             Int
  itemName               String
  description            String?
  price                  Float
  avgPreparationTimeMins Int
  isAvailable            Boolean      @default(true)
  orderItems             OrderItem[]
}

model Waiter {
  id            Int        @id @default(autoincrement())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  Int
  fullName      String
  phoneNumber   String
  shiftSchedule String
  orders        Order[]
}

model Chef {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  fullName     String
  specialty    String
  phoneNumber  String
  orders       Order[]
}

model Bartender {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  fullName     String
  phoneNumber  String
  orders       Order[]
}

model Order {
  id                   Int         @id @default(autoincrement())
  visit                Visit       @relation(fields: [visitId], references: [id])
  visitId              Int
  waiter               Waiter?     @relation(fields: [waiterId], references: [id])
  waiterId             Int?
  chef                 Chef?       @relation(fields: [chefId], references: [id])
  chefId               Int?
  bartender            Bartender?  @relation(fields: [bartenderId], references: [id])
  bartenderId          Int?
  orderTime            DateTime    @default(now())
  status               OrderStatus @default(PENDING)
  estimatedWaitTimeMins Int
  orderItems           OrderItem[]
  payment              Payment?
  feedbacks            Feedback[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  quantity   Int
  subTotal   Float
}

model Payment {
  id            Int           @id @default(autoincrement())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       Int           @unique
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    Int
  amount        Float
  paymentMethod String
  paymentTime   DateTime      @default(now())
  paymentStatus PaymentStatus @default(COMPLETED)
  isPretend     Boolean       @default(true)
}

model Feedback {
  id            Int      @id @default(autoincrement())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       Int
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    Int
  complaintText String
  rating        Int
  dateSubmitted DateTime @default(now())
}
