// Chowly data model
// Fully integrated with multi-stage order workflow, waiter tracking, and payment statuses.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  ACCEPTED_BY_WAITER
  ASSIGNED_TO_CHEF
  PREPARING
  BARTENDER_PROCESSING
  READY
  COMPLETED
  CANCELLED
  DELAYED
}

enum PaymentStatus {
  PENDING
  PAID
  COMPLETED
  FAILED
}

model Restaurant {
  id           Int          @id @default(autoincrement())
  name         String
  address      String
  phoneNumber  String
  email        String
  openingHours String
  menuItems    MenuItem[]
  waiters      Waiter[]
  chefs        Chef[]
  bartenders   Bartender[]
  visits       Visit[]
  createdAt    DateTime     @default(now())
}

model Customer {
  id             Int          @id @default(autoincrement())
  fullName       String
  phoneNumber    String?
  dateRegistered DateTime     @default(now())
  visits         Visit[]
  payments       Payment[]
  feedbacks      Feedback[]
}

model Visit {
  id           Int        @id @default(autoincrement())
  customer     Customer   @relation(fields: [customerId], references: [id])
  customerId   Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  tableNumber  Int
  checkInTime  DateTime   @default(now())
  checkOutTime DateTime?
  orders       Order[]
}

model MenuCategory {
  id           Int        @id @default(autoincrement())
  categoryName String
  menuItems    MenuItem[]
}

model MenuItem {
  id                       Int          @id @default(autoincrement())
  restaurant               Restaurant   @relation(fields: [restaurantId], references: [id])
  restaurantId             Int
  category                 MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId               Int
  itemName                 String
  description              String?
  price                    Float
  avgPreparationTimeMins Int
  isAvailable              Boolean      @default(true)
  orderItems               OrderItem[]
}

model Waiter {
  id            Int        @id @default(autoincrement())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  Int
  fullName      String
  phoneNumber   String
  shiftSchedule String
  orders        Order[]
}

model Chef {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  fullName     String
  specialty    String
  phoneNumber  String
  orders       Order[]
}

model Bartender {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  fullName     String
  phoneNumber  String
  orders       Order[]
}

model Order {
  id                    Int           @id @default(autoincrement())
  visit                 Visit         @relation(fields: [visitId], references: [id])
  visitId               Int
  waiter                Waiter?       @relation(fields: [waiterId], references: [id])
  waiterId              Int?
  chef                  Chef?         @relation(fields: [chefId], references: [id])
  chefId                Int?
  bartender             Bartender?    @relation(fields: [bartenderId], references: [id])
  bartenderId           Int?
  orderTime             DateTime      @default(now())
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  prepTime              Int?          // Estimated prep time in minutes set by chef
  estimatedWaitTimeMins Int?
  orderItems            OrderItem[]
  payment               Payment?
  feedbacks             Feedback[]
  updatedAt             DateTime      @updatedAt
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  quantity   Int
  subTotal   Float
  category   String?  // e.g., "food" or "drink" to route between chef and bartender
  notes      String?
}

model Payment {
  id            Int           @id @default(autoincrement())
  order         Order         @relation(fields: [orderId], references: [id])
  orderId       Int           @unique
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    Int
  amount        Float
  paymentMethod String
  paymentTime   DateTime      @default(now())
  paymentStatus PaymentStatus @default(COMPLETED)
  isPretend     Boolean       @default(true)
}

model Feedback {
  id            Int      @id @default(autoincrement())
  order         Order    @relation(fields: [orderId], references: [id])
  orderId       Int
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    Int
  complaintText String
  rating        Int
  dateSubmitted DateTime @default(now())
}